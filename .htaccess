# Configuración de Apache/LiteSpeed para Hostinger.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio único sin www. Hostinger ya fuerza HTTPS a nivel de servidor.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://sh-esotericos.com/$1 [R=301,L]

  # Páginas de la web anterior que pudieron quedar enlazadas o indexadas.
  RewriteRule ^brujeria\.html$ /#consultas [R=301,NE,L]
  RewriteRule ^estructura\.html$ / [R=301,L]
  RewriteRule ^archivo/web-anterior/brujeria\.html$ /#consultas [R=301,NE,L]
  RewriteRule ^archivo/web-anterior/(index\.html)?$ / [R=301,L]

  # Fichas anteriores a las páginas estáticas: ?id=<producto> pasa a /producto/<id>/.
  RewriteCond %{QUERY_STRING} (?:^|&)id=([a-z0-9-]+)
  RewriteRule ^producto-(?:catalogo|pirograbado)\.html$ /producto/%1/? [R=301,L]
  RewriteRule ^producto-(?:catalogo|pirograbado)\.html$ /#catalogo [R=301,NE,L]
  RewriteRule ^producto-lobos\.html$ /producto/coleccion-lobos/ [R=301,L]
  RewriteRule ^producto-fenix\.html$ /producto/coleccion-fenix/ [R=301,L]

  # Material de trabajo que se despliega con el repositorio pero no es público.
  RewriteRule ^(archivo|scripts|productos-originales)(/|$) - [R=404,L]
  RewriteRule \.(md|py)$ - [R=404,L]
</IfModule>
